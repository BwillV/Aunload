<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#16213e">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/txt_qr_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/diag_qr_titulo"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/txt_qr_instr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/diag_qr_instruccion"
            android:textColor="#BBBBBB"
            android:textSize="13sp"
            android:textAlignment="center"
            android:paddingBottom="14dp" />

        <ImageView
            android:id="@+id/img_qr"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:contentDescription="@string/diag_qr_titulo" />

        <TextView
            android:id="@+id/txt_qr_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#80CBC4"
            android:textSize="10sp"
            android:textAlignment="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/btn_qr_cerrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cd_cerrar"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textAlignment="center"
            android:padding="14dp"
            android:layout_marginTop="4dp"
            android:background="#F44336"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>
