<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de cada segmento del selector de modo (v5.19).
     Seleccionado = azul relleno; no seleccionado = contorno gris. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#1E88E5" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#1E88E5" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#13293f" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#3a5e82" />
        </shape>
    </item>
</selector>
