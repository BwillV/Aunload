<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Estado de la grabación -->
        <TextView
            android:id="@+id/txt_diag_estado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#999999"
            android:textSize="14sp"
            android:padding="8dp" />

        <!-- Botón: Comenzar / Detener grabación -->
        <TextView
            android:id="@+id/btn_diag_grabar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶ Comenzar diagnóstico"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textAlignment="center"
            android:padding="14dp"
            android:layout_marginTop="8dp"
            android:background="#2196F3"
            android:clickable="true"
            android:focusable="true" />

        <!-- Botón: Copiar al portapapeles -->
        <TextView
            android:id="@+id/btn_diag_copiar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 Copiar diagnóstico"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textAlignment="center"
            android:padding="14dp"
            android:layout_marginTop="8dp"
            android:background="#4CAF50"
            android:clickable="true"
            android:focusable="true" />

        <!-- Botón: Refrescar -->
        <TextView
            android:id="@+id/btn_diag_refrescar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 Actualizar"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textAlignment="center"
            android:padding="14dp"
            android:layout_marginTop="8dp"
            android:background="#FF9800"
            android:clickable="true"
            android:focusable="true" />

        <!-- Botón: Borrar datos -->
        <TextView
            android:id="@+id/btn_diag_borrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🗑 Borrar diagnóstico"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textAlignment="center"
            android:padding="14dp"
            android:layout_marginTop="8dp"
            android:background="#F44336"
            android:clickable="true"
            android:focusable="true" />

        <!-- Contenido del diagnóstico -->
        <TextView
            android:id="@+id/txt_diag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            android:background="#0d0d1a"
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>
